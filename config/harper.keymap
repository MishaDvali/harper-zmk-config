#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

#define DEF 0
#define LWR 1
#define RSE 2
#define ADJ 3

&lt { quick_tap_ms = <200>; };

&mt { quick_tap_ms = <200>; };

/ {
    keymap {
        compatible = "zmk,keymap";

        default {
            bindings = <
&kp NUMBER_1       &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5  &kp NUMBER_6                 &kp NUMBER_7    &kp N8  &kp N9     &kp N0     &kp F11           &kp F12
&kp RIGHT_BRACKET  &kp Q         &kp W         &kp E         &kp R   &kp T                        &kp Y           &kp U   &kp I      &kp O      &kp P             &kp LEFT_BRACKET
&mo 4              &kp A         &kp S         &kp D         &kp F   &kp G                        &kp H           &kp J   &kp K      &kp L      &kp SEMI          &kp SQT
&kp ESCAPE         &kp Z         &kp X         &kp C         &kp V   &kp B                        &kp C_MUTE      &none   &kp N      &kp M      &kp COMMA         &kp DOT
&kp FSLH           &kp LEFT_WIN  &kp LCTRL     &kp LEFT_ALT  &tog 4  &kp LEFT_ALT  &kp BACKSPACE  &kp LEFT_SHIFT  &mo 1   &kp ENTER  &kp SPACE  &kp LEFT_BRACKET  &kp LCTRL         &mo 2
                                                                                                  &kp RIGHT_ALT                                                                     &kp RIGHT_CONTROL
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp PG_DN PG_UP>;
        };

        symbols {
            bindings = <
&kp F1             &kp F2        &kp F3          &kp F4        &kp F5        &kp F6             &kp F7          &kp F8          &kp F9     &kp F10         &kp F11           &kp ESC
&kp RIGHT_BRACKET  &none         &kp LEFT_ARROW  &kp RIGHT     &kp ESCAPE    &kp ESCAPE         &kp ESC         &kp ESCAPE      &kp MINUS  &kp EQUAL       &kp EQUAL         &kp LEFT_BRACKET
&kp ENTER          &kp NUMBER_1  &kp NUMBER_2    &kp NUMBER_3  &kp NUMBER_4  &kp N5             &kp NUMBER_6    &kp N7          &kp N8     &kp N9          &kp N0            &kp NON_US_BACKSLASH
&kp ESCAPE         &kp ESC       &kp ESC         &kp UP_ARROW  &kp ESC       &kp ESC            &kp ESC         &kp ESC         &kp ESC    &kp ESC         &kp DOWN          &kp UP_ARROW
&kp ESC            &kp ESC       &kp ESC         &kp ESC       &kp ESC       &kp ESC     &mo 0  &kp LEFT_SHIFT  &kp DOWN_ARROW  &kp ENTER  &kp LEFT_SHIFT  &kp LEFT_CONTROL  &kp LEFT_CONTROL      &kp ESC
                                                                                                &kp ESC                                                                                            &kp ESC
            >;
        };

        keyboard {
            bindings = <
&trans      &trans        &trans        &trans        &trans        &trans                &trans           &trans           &trans           &trans           &trans           &trans
&trans      &none         &none         &none         &none         &none                 &trans           &trans           &trans           &trans           &trans           &trans
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4          &rgb_ug RGB_TOG  &rgb_ug RGB_EFF  &rgb_ug RGB_BRI  &rgb_ug RGB_BRD  &rgb_ug RGB_SAI  &rgb_ug RGB_SAD
&trans      &trans        &trans        &trans        &trans        &trans                &trans           &trans           &trans           &rgb_ug RGB_SPI  &rgb_ug RGB_SPD  &trans
&trans      &trans        &trans        &trans        &trans        &trans        &trans  &trans           &trans           &trans           &trans           &trans           &trans           &trans
                                                                                          &trans                                                                                                &trans
            >;
        };

        layer_4 {
            bindings = <
&kp GRAVE  &trans    &trans    &trans     &trans  &trans                &trans            &trans          &trans  &trans           &trans    &kp F12
&trans     &trans    &kp LEFT  &kp RIGHT  &trans  &trans                &trans            &trans          &kp UP  &kp DOWN         &trans    &trans
&kp CAPS   &kp F1    &kp F2    &kp F3     &kp F4  &kp F5                &kp F6            &kp F7          &kp F8  &kp F9           &kp F10   &kp F11
&kp LGUI   &trans    &trans    &trans     &trans  &trans                &trans            &trans          &trans  &trans           &trans    &trans
&trans     &kp LGUI  &trans    &trans     &trans  &trans  &kp LEFT_ALT  &kp LEFT_CONTROL  &kp LEFT_SHIFT  &mo 4   &kp RIGHT_SHIFT  &kp RALT  &trans   &trans
                                                                        &trans                                                                        &trans
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans             &trans          &trans          &trans        &trans           &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans             &trans          &trans          &trans        &trans           &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans             &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans             &trans          &trans          &trans        &trans           &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &mkp MCLK  &mkp LCLK       &mkp RCLK       &trans        &trans           &trans  &trans  &trans
                                                           &trans                                                                         &trans
            >;
        };
    };
};
